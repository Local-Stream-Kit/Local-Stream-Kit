{
  "id": "media",
  "name": "Show media",
  "version": "1.0.0",
  "api": 1,
  "author": "Local Stream Kit",
  "description": "Show a picture or a video on the overlay",
  "nodes": [
    {
      "id": "show",
      "title": "Show media",
      "category": "effects",
      "queue": "optional",
      "inputs": [
        { "name": "trigger", "label": "Trigger", "type": "event" },
        { "name": "seconds", "label": "Seconds (0 = auto)", "type": "number" }
      ],
      "settings": [
        { "key": "media", "label": "Show", "type": "media" },
        { "key": "position", "label": "Where", "type": "position", "default": "center", "random": true },
        { "key": "height", "label": "Height (px)", "type": "number", "default": 400, "min": 10, "max": 2160 },
        {
          "key": "animation",
          "label": "Animation",
          "type": "choice",
          "default": "pop",
          "options": [
            { "value": "pop", "label": "Pop" },
            { "value": "fade", "label": "Fade" },
            { "value": "slide_up", "label": "Slide up" },
            { "value": "slide_down", "label": "Slide down" },
            { "value": "none", "label": "None" }
          ]
        },
        { "key": "tilt", "label": "Tilt (°)", "type": "number", "default": 0, "min": -180, "max": 180 },
        { "key": "volume", "label": "Volume (%)", "type": "number", "default": 80, "min": 0, "max": 100 },
        { "key": "seconds", "label": "Seconds (0 = auto)", "type": "number", "default": 0, "min": 0, "max": 600 },
        { "key": "queue", "label": "Wait in the queue", "type": "bool", "default": false }
      ]
    }
  ]
}
